rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Event Attachments & Documentation (Module 10 Post-Event Report, Media, Accreditation)
    match /events/{eventId}/attachments/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 2. Post-Event Report Media & Accreditation Documents
    match /reports/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 3. User Profile Avatars
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId) &&
        request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isSignedIn() && (request.auth.uid == userId);
    }

    // Default Fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size <= 100 * 1024 * 1024;
      allow delete: if isSignedIn();
    }
  }
}
