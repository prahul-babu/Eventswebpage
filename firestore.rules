rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId);
    }

    // Users Collection (Profile Management)
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Faculty Applications Collection (Account Approval Workflow)
    match /facultyApplications/{appId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Events Collection (Faculty Ownership & Student Catalog)
    match /events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Registrations Collection (Student Bookings & Check-ins)
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Mail Queue Collection (Firebase Trigger Email extension)
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Notifications Collection (In-app notifications)
    match /notifications/{notifId} {
      allow read, write: if true;
      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Audit Logs Collection (System Governance)
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // General fallback for collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
