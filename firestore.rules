rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId);
    }

    // Users Collection (Profile Management)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Events Collection (Faculty Ownership & Student Catalog)
    match /events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Registrations Collection (Student Bookings & Check-ins)
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Audit Logs Collection (System Governance)
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Event Reports & Other Sub-collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
